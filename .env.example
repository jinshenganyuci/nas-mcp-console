# Optional settings for compose.fnos.yaml; all have usable defaults.
MCP_IMAGE=docker.io/jinshenganyuci/nas-mcp-console:0.2.0
MCP_DATA_VOLUME=nas-mcp-data
BIND_ADDRESS=0.0.0.0
MCP_PORT=8090
# Optional: comma-separated domain names, without https:// or port.
# You can also add these in the admin UI after accessing the NAS by LAN IP.
ALLOWED_HOSTS=
# Only compose.yaml (source development with ./data) uses these IDs.
# Match the owner of ./data; compose.fnos.yaml uses UID/GID 1000 and a named volume.
PUID=1000
PGID=1000
